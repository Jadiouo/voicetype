{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceType Preview",
  "version": "0.2.0-alpha.1",
  "identifier": "io.github.jadiouo.voicetype.preview",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "VoiceType Preview", "width": 900, "height": 720, "minWidth": 620, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "category": "Utility",
    "shortDescription": "VoiceType desktop settings preview",
    "longDescription": "Development preview of VoiceType's cross-platform settings. Speech adapters are not connected in this build.",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "publisher": "VoiceType contributors",
    "homepage": "https://github.com/Jadiouo/voicetype",
    "resources": { "../../LICENSE": "LICENSE.txt", "../README.md": "PREVIEW.md" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["TradChinese", "English"], "displayLanguageSelector": true } }
  }
}
